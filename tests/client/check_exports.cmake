# Fails unless every dynamic symbol DEFINED by ${LIB} is a mira_* function and the core ABI is there.
execute_process(COMMAND nm -D --defined-only ${LIB} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "nm -D failed on ${LIB}")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(n 0)
foreach(l IN LISTS lines)
  if(l STREQUAL "")
    continue()
  endif()
  string(REGEX REPLACE "^[0-9a-fA-F]+ +[A-Za-z] +" "" sym "${l}")
  if(NOT sym MATCHES "^mira_")
    message(FATAL_ERROR "non-mira_ symbol exported: ${sym}")
  endif()
  math(EXPR n "${n}+1")
endforeach()
foreach(req mira_abi_version mira_client_open mira_client_open_loopback mira_client_close mira_attach_region
        mira_put mira_fetch mira_lookup_nb mira_poll mira_event_fd mira_strerror mira_client_metrics
        mira_check_block_size)
  if(NOT out MATCHES " ${req}\n")
    message(FATAL_ERROR "missing export: ${req}")
  endif()
endforeach()
message(STATUS "exports ok: ${n} mira_* symbols")
